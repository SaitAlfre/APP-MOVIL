rules_version = '2';

// Reglas de demostración académica para Ecolecta Huata (Grupo 5). NO son un mecanismo de seguridad de
// producción: la autenticación es anónima (un uid estable por dispositivo, sin verificar identidad
// real) y solo sirve para que estas reglas sepan a qué usuario/zona local corresponde cada uid.
//
// Vinculación manual: `acopiador_links/{uid}` = { usuarioId, zonaId } y `proveedor_links/{uid}` =
// { usuarioId, zonaId, proveedorCodigo } se crean A MANO desde Firebase Console con el UID que cada
// celular muestra en la app — la app nunca tiene permiso de leerlos ni escribirlos, así que no puede
// reclamar un usuario ajeno, cambiar su zona ni leer registros de otro proveedor. Sin Cloud Functions.
service cloud.firestore {
  match /databases/{database}/documents {

    match /acopiador_links/{uid} {
      allow read, write: if false;
    }
    match /proveedor_links/{uid} {
      allow read, write: if false;
    }

    // registros_acopio/{registroId}: entregas y "sin recojo" que el ACOPIADOR comparte con el
    // PROVEEDOR (reemplaza al seguimiento GPS `rutas_activas`, retirado). Un documento por registro:
    // el id es el del registro local, así que reenviar sobrescribe y nunca duplica. Nunca se borra.
    match /registros_acopio/{registroId} {
      function vinculoAcopiador() {
        return get(/databases/$(database)/documents/acopiador_links/$(request.auth.uid)).data;
      }
      function vinculoProveedor() {
        return get(/databases/$(database)/documents/proveedor_links/$(request.auth.uid)).data;
      }
      function esAcopiadorDeLaZona(zonaId) {
        return request.auth != null &&
          exists(/databases/$(database)/documents/acopiador_links/$(request.auth.uid)) &&
          vinculoAcopiador().zonaId == zonaId;
      }
      function datosValidos(d) {
        return d.id == registroId &&
          d.tipo in ['ENTREGA', 'SIN_RECOJO'] &&
          d.proveedorCodigo is string && d.proveedorCodigo.size() > 0 &&
          d.fecha is string && d.actualizadoEn is int &&
          (d.tipo != 'ENTREGA' || (d.litros is number && d.litros > 0)) &&
          (d.tipo != 'SIN_RECOJO' || (d.motivo is string && d.motivo.size() > 0));
      }

      // PRIVACIDAD: el PROVEEDOR solo lee documentos de SU código, fijado a mano en su vínculo
      // (proveedor_links/{uid}.proveedorCodigo). Una consulta sin ese filtro se rechaza entera.
      allow get, list: if request.auth != null &&
        exists(/databases/$(database)/documents/proveedor_links/$(request.auth.uid)) &&
        vinculoProveedor().proveedorCodigo is string &&
        resource.data.proveedorCodigo == vinculoProveedor().proveedorCodigo;

      // Alta: el ACOPIADOR debe ser quien dice ser (su usuarioId) y estar autorizado para la zona.
      allow create: if esAcopiadorDeLaZona(request.resource.data.zonaId) &&
        vinculoAcopiador().usuarioId == request.resource.data.acopiadorId &&
        datosValidos(request.resource.data);

      // Corrección / anulación / "deshacer": cualquier acopiador autorizado para la MISMA zona (relevo
      // o corrección en el mismo celular); nunca cambia de proveedor, zona, tipo ni autor, y una
      // escritura atrasada (actualizadoEn menor) no puede pisar una más nueva.
      allow update: if esAcopiadorDeLaZona(resource.data.zonaId) &&
        datosValidos(request.resource.data) &&
        request.resource.data.zonaId == resource.data.zonaId &&
        request.resource.data.proveedorCodigo == resource.data.proveedorCodigo &&
        request.resource.data.tipo == resource.data.tipo &&
        request.resource.data.acopiadorId == resource.data.acopiadorId &&
        request.resource.data.actualizadoEn >= resource.data.actualizadoEn;

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
