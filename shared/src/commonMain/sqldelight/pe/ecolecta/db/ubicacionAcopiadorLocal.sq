-- OBSOLETA: pertenecía al seguimiento GPS ("Mi ruta"), retirado y reemplazado por la lista de acopio.
-- La tabla se conserva sin consultas para no borrar datos de dispositivos ya instalados.
CREATE TABLE ubicacion_acopiador_local (
    usuario_id TEXT NOT NULL PRIMARY KEY,
    jornada_id TEXT NOT NULL,
    zona_id TEXT NOT NULL,
    lat REAL NOT NULL,
    lng REAL NOT NULL,
    precision_m REAL NOT NULL,
    capturada_en INTEGER NOT NULL,
    publicada INTEGER NOT NULL DEFAULT 0
);
