CREATE TABLE portal_proveedor (
    id TEXT NOT NULL PRIMARY KEY,
    proveedor_id TEXT NOT NULL REFERENCES proveedor(id),
    tipo TEXT NOT NULL,
    contenido TEXT NOT NULL,
    creado_en INTEGER NOT NULL
);

porProveedor:
SELECT * FROM portal_proveedor WHERE proveedor_id = ? ORDER BY creado_en DESC;

guardar:
INSERT INTO portal_proveedor(id, proveedor_id, tipo, contenido, creado_en) VALUES (?, ?, ?, ?, ?);
