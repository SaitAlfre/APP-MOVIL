-- Coder 1: revocación conocida. No borra cuentas, PIN, relaciones ni cambios pendientes.
ALTER TABLE usuario ADD COLUMN requiere_verificacion INTEGER NOT NULL DEFAULT 0;

-- Las marcas confirmadas por el canal anterior todavía deben llegar a la API oficial.
-- Se conservan ids, contenido e historial; el envío es idempotente.
UPDATE sin_recojo SET sync_state = 'PENDING', sync_error = NULL WHERE sync_state = 'SYNCED';
