CREATE TABLE jornada (
    id TEXT NOT NULL PRIMARY KEY,
    usuario_id TEXT NOT NULL,
    zona_id TEXT NOT NULL,
    vehiculo_id TEXT NOT NULL,
    fecha TEXT NOT NULL,
    abierta_en INTEGER NOT NULL,
    cerrada_en INTEGER,
    sync_state TEXT NOT NULL DEFAULT 'PENDING'
);

CREATE INDEX jornada_fecha_idx ON jornada(fecha);
CREATE INDEX jornada_usuario_idx ON jornada(usuario_id);

insertar:
INSERT INTO jornada(id, usuario_id, zona_id, vehiculo_id, fecha, abierta_en, cerrada_en, sync_state)
VALUES (:id, :usuario_id, :zona_id, :vehiculo_id, :fecha, :abierta_en, NULL, :sync_state);

cerrar:
UPDATE jornada SET cerrada_en = :cerrada_en WHERE id = :id;

-- Reapertura controlada de la MISMA jornada (ver ReabrirJornadaUseCase). La hora del cierre que se
-- deshace queda en la auditoría; aquí solo se vuelve a marcar abierta.
reabrir:
UPDATE jornada SET cerrada_en = NULL WHERE id = :id AND cerrada_en IS NOT NULL;

selectTodas:
SELECT * FROM jornada ORDER BY abierta_en DESC;

selectPorId:
SELECT * FROM jornada WHERE id = :id;

selectPorUsuarioYFecha:
SELECT * FROM jornada WHERE usuario_id = :usuario_id AND fecha = :fecha;

selectConFiltros:
SELECT * FROM jornada
WHERE (:fecha IS NULL OR fecha = :fecha)
  AND (:usuario_id IS NULL OR usuario_id = :usuario_id)
  AND (:zona_id IS NULL OR zona_id = :zona_id)
  AND (:vehiculo_id IS NULL OR vehiculo_id = :vehiculo_id)
ORDER BY abierta_en DESC;

contarAbiertas:
SELECT COUNT(*) FROM jornada WHERE cerrada_en IS NULL;

selectAbiertaPorZona:
SELECT * FROM jornada WHERE zona_id = :zona_id AND cerrada_en IS NULL LIMIT 1;

-- ORDER BY abierta_en ASC: si por algún motivo hubiera más de una jornada abierta para el mismo
-- usuario (no debería ocurrir en operación normal, ver ReanudarJornadaSiExisteUseCase), se retoma
-- siempre la más antigua primero, nunca una elegida arbitrariamente.
selectAbiertaPorUsuario:
SELECT * FROM jornada WHERE usuario_id = :usuario_id AND cerrada_en IS NULL ORDER BY abierta_en ASC LIMIT 1;

selectAbiertaPorVehiculo:
SELECT * FROM jornada WHERE vehiculo_id = :vehiculo_id AND cerrada_en IS NULL LIMIT 1;
