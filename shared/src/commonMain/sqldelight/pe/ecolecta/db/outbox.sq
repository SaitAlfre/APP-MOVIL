-- Cola de sincronización local. El registro offline ya encola aquí (§25); el SyncEngine que
-- procesa estas filas contra el backend llega en la Fase 4. El payload guarda solo la
-- referencia (entidad_id): el motor de sync relee el registro completo desde su tabla al
-- procesar, en vez de duplicar el snapshot antes de que exista un contrato de API real.
CREATE TABLE outbox (
    id TEXT NOT NULL PRIMARY KEY,
    entidad TEXT NOT NULL,
    entidad_id TEXT NOT NULL,
    operacion TEXT NOT NULL,
    payload TEXT NOT NULL,
    creado_en INTEGER NOT NULL,
    intentos INTEGER NOT NULL DEFAULT 0,
    ultimo_error TEXT,
    estado TEXT NOT NULL DEFAULT 'PENDING'
);

insertar:
INSERT INTO outbox(id, entidad, entidad_id, operacion, payload, creado_en, intentos, ultimo_error, estado)
VALUES (:id, :entidad, :entidad_id, :operacion, :payload, :creado_en, 0, NULL, 'PENDING');

selectTodos:
SELECT * FROM outbox ORDER BY creado_en DESC;

contarPendientes:
SELECT COUNT(*) FROM outbox WHERE estado = 'PENDING';
