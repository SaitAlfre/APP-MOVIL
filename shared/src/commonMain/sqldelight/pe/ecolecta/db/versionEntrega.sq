CREATE TABLE version_entrega_servidor (entrega_id TEXT NOT NULL PRIMARY KEY, version INTEGER NOT NULL, revision TEXT);
obtener:
SELECT version FROM version_entrega_servidor WHERE entrega_id = ?;
guardar:
INSERT OR REPLACE INTO version_entrega_servidor(entrega_id, version) VALUES (?, ?);

revision:
SELECT revision FROM version_entrega_servidor WHERE entrega_id = ?;
guardarRevision:
UPDATE version_entrega_servidor SET revision = ? WHERE entrega_id = ?;
